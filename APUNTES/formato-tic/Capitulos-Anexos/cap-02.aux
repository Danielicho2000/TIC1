\newlabel{fig:gutenberg_richter}{{2.2}{10}{Relación de Gutenberg-Richter: $\log _{10}(N) = a - bM$ para el catálogo de eventos sísmicos filtrado por magnitud de completitud}{figure.2.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Función K de Ripley para el catálogo de eventos sísmicos. Para un patrón de clustering, se debe cumplir que $K(r) > \pi r^2$, lo cual se evidencia estadísticamente también con el valor p=0.01 por Envolventes de Monte Carlo que no cumple con CSR ($H_0$).}}{11}{figure.2.3}\protected@file@percent }
\newlabel{fig:k_ripley}{{2.3}{11}{Función K de Ripley para el catálogo de eventos sísmicos. Para un patrón de clustering, se debe cumplir que $K(r) > \pi r^2$, lo cual se evidencia estadísticamente también con el valor p=0.01 por Envolventes de Monte Carlo que no cumple con CSR ($H_0$)}{figure.2.3}{}}
